# -----------------------------------------------------------------------------
# InfluencerHub Multi-Environment Configuration Template
# Environment Options: local | qa | uat | production
# -----------------------------------------------------------------------------

# Environment Identifier
APP_ENV=local
NODE_ENV=development

# Express / Better Auth Backend Configuration
PORT=5001
BETTER_AUTH_SECRET=your_random_secret_32_characters_long_key_here
BETTER_AUTH_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5000

# PostgreSQL Database Connection Strings
# IMPORTANT: Use ISOLATED PostgreSQL databases for LOCAL, QA, UAT, and PRODUCTION.
# NEVER reuse production DATABASE_URL in QA, UAT, or LOCAL!
DATABASE_URL=postgres://postgres:postgres@localhost:5432/influencer_hub

# Frontend Web App Environment Configuration
VITE_API_URL=http://localhost:5001
