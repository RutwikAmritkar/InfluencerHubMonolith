# -----------------------------------------------------------------------------
# InfluencerHub Multi-Environment Configuration Template
# Environment Options: local | qa | uat | production
# -----------------------------------------------------------------------------

# Environment Identifier
APP_ENV=local
NODE_ENV=development

# Express / Better Auth Backend Configuration
PORT=5001
APP_URL=https://creatorsbrand.in
FRONTEND_URL=http://localhost:5000
BETTER_AUTH_SECRET=your_random_secret_32_characters_long_key_here
BETTER_AUTH_URL=http://localhost:5001
EMAIL_VERIFICATION_REQUIRED=false

# Transactional Email Alerts (Resend Cloud or SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=CreatorsBrand <notifications@creatorsbrand.in>
# Optional SMTP Fallback:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_smtp_password

# PostgreSQL Database Connection Strings
# IMPORTANT: Use ISOLATED PostgreSQL databases for LOCAL, QA, UAT, and PRODUCTION.
# NEVER reuse production DATABASE_URL in QA, UAT, or LOCAL!
DATABASE_URL=postgres://postgres:postgres@localhost:5432/influencer_hub

# Frontend Web App Environment Configuration (Leave unset for single-origin relative /api paths)
# VITE_API_URL=https://creatorsbrand.in
